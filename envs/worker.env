APPLICATION_NAME=yt_worker

MAX_SIMULTANEOUS_DOWNLOADS=2
MAX_DOWNLOAD_THREADS=10
# Max download speed, e.g. 500K or 4.2M. Empty means no limit.
DOWNLOAD_RATE_LIMIT=
# Preferred language for titles, descriptions and chapters, e.g. ru.
# Empty leaves whatever the site serves by default.
METADATA_LANGUAGE=

STORAGE_PATH=/filestorage

THUMBNAIL_FRAME_SECOND=10.0
INSTAGRAM_ENCODE_TO_H264=True
FACEBOOK_ENCODE_TO_H264=True
